POSTGRES_DB=streaming_events
POSTGRES_USER=streaming_admin
POSTGRES_PASSWORD=replace_with_a_local_admin_password
POSTGRES_APP_USER=streaming_consumer
POSTGRES_APP_PASSWORD=replace_with_a_different_local_app_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=playback-events
KAFKA_TOPIC_PARTITIONS=3
KAFKA_CONSUMER_GROUP=playback-events-consumer

PRODUCER_INTERVAL_SECONDS=1
LOG_LEVEL=INFO
